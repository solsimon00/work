rules_version = '2';
// Reglas de Firestore para "¿Con qué pago?": cada persona solo lee y escribe su propio perfil.
// Pegalas en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /subs/{sub} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
